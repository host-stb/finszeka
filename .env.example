# Gerçek FastAPI backend'inin (satzeka / Logo entegrasyonu) adresi.
# Tanımlanmazsa uygulama otomatik olarak örnek (mock) veriyle çalışır.
FASTAPI_BASE_URL=https://api.nutramolai.com

# FastAPI backend'i bir API anahtarı/Bearer token bekliyorsa doldurun.
# (Opsiyonel — kullanılmıyorsa boş bırakın.)
FASTAPI_API_KEY=

# --- Google ile giriş (erişim kısıtlama) ---
# Google Cloud Console'dan alacağınız OAuth 2.0 Client ID/Secret.
# Adımlar için README.md -> "Google ile giriş (erişim kısıtlama)" bölümüne bakın.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# `openssl rand -base64 32` ile üretin (her ortam için ayrı bir değer önerilir).
AUTH_SECRET=

# Sadece bu e-postalar giriş yapabilir (virgülle ayrılmış).
ALLOWED_EMAILS=sansel@nutramol.com,agunes@nutramol.com

# localhost:3000 dışında bir portta/domainde çalıştırırken ya da Vercel gibi
# bir proxy arkasında iken gerekli (yoksa "UntrustedHost" hatası alırsınız).
AUTH_TRUST_HOST=true
